    <section class="demo-section" id="demo">
      <div class="container">
        <div class="section-header">
          <div class="section-tag">Live-Demo</div>
          <h2>Jetzt selbst ausprobieren</h2>
          <p>Tragen Sie Ihre Objektdaten ein und erleben Sie, wie ImmoBoost AI innerhalb von Sekunden professionelle Marketingtexte erstellt.</p>
        </div>

        <div class="demo__layout">
          <!-- FORM -->
          <div class="demo__form-wrap">
            <form class="demo__form" id="demoForm" novalidate>
              <h3 class="form__title">Objektdaten eingeben</h3>

              <div class="form__row">
                <div class="form__group">
                  <label for="objektart">Objektart *</label>
                  <select id="objektart" name="objektart" required>
                    <option value="">Bitte wählen …</option>
                    <option value="Wohnung">Wohnung</option>
                    <option value="Haus">Haus</option>
                    <option value="Villa">Villa</option>
                    <option value="Grundstück">Grundstück</option>
                  </select>
                  <span class="form__error" id="err-objektart"></span>
                </div>
                <div class="form__group">
                  <label for="stadt">Stadt *</label>
                  <input type="text" id="stadt" name="stadt" placeholder="z. B. München" required />
                  <span class="form__error" id="err-stadt"></span>
                </div>
              </div>

              <div class="form__row">
                <div class="form__group">
                  <label for="preis">Kaufpreis (€) *</label>
                  <input type="text" id="preis" name="preis" placeholder="z. B. 850.000" required />
                  <span class="form__error" id="err-preis"></span>
                </div>
                <div class="form__group">
                  <label for="flaeche">Wohnfläche (m²) *</label>
                  <input type="text" id="flaeche" name="flaeche" placeholder="z. B. 120" required />
                  <span class="form__error" id="err-flaeche"></span>
                </div>
              </div>

              <div class="form__row">
                <div class="form__group">
                  <label for="zimmer">Zimmer *</label>
                  <input type="text" id="zimmer" name="zimmer" placeholder="z. B. 4" required />
                  <span class="form__error" id="err-zimmer"></span>
                </div>
                <div class="form__group">
                  <label for="zielgruppe">Zielgruppe *</label>
                  <select id="zielgruppe" name="zielgruppe" required>
                    <option value="">Bitte wählen …</option>
                    <option value="Familie">Familie</option>
                    <option value="Investor">Investor</option>
                    <option value="Paar">Paar</option>
                    <option value="Luxus-Käufer">Luxus-Käufer</option>
                  </select>
                  <span class="form__error" id="err-zielgruppe"></span>
                </div>
              </div>

              <div class="form__group">
                <label for="besonderheiten">Besonderheiten</label>
                <textarea id="besonderheiten" name="besonderheiten" rows="3" placeholder="z. B. Dachterrasse, Tiefgarage, Erstbezug, Panoramablick …"></textarea>
              </div>

              <div class="form__group">
                <label for="tonalitaet">Tonalität *</label>
                <select id="tonalitaet" name="tonalitaet" required>
                  <option value="">Bitte wählen …</option>
                  <option value="Premium">Premium</option>
                  <option value="emotional">Emotional</option>
                  <option value="sachlich">Sachlich</option>
                  <option value="modern">Modern</option>
                </select>
                <span class="form__error" id="err-tonalitaet"></span>
              </div>

              <button type="submit" class="btn btn--primary btn--full btn--lg" id="generateBtn">
                <span id="btnText">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="display:inline;vertical-align:-3px;margin-right:6px"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
                  Marketingtexte generieren
                </span>
                <span id="btnLoading" style="display:none">⟳ Generiere Texte …</span>
              </button>
            </form>
          </div>
        </div>

        <!-- RESULTS -->
        <div class="demo__results" id="demoResults" style="display:none">
          <div class="results__header">
            <h3>✦ Ihre generierten Marketingtexte</h3>
            <button class="btn btn--outline" id="copyAllBtn">
              📋 Alle Texte kopieren
            </button>
          </div>

          <div class="results__tabs" role="tablist">
            <button class="results__tab results__tab--active" data-tab="expose" role="tab">Exposé</button>
            <button class="results__tab" data-tab="immo" role="tab">ImmoScout</button>
            <button class="results__tab" data-tab="instagram" role="tab">Instagram</button>
            <button class="results__tab" data-tab="email" role="tab">E-Mail</button>
            <button class="results__tab" data-tab="whatsapp" role="tab">WhatsApp</button>
          </div>

          <div class="results__panels">

            <div class="results__panel results__panel--active" id="panel-expose">
              <div class="panel__top">
                <span class="panel__label">📄 Exposé-Text</span>
                <button class="btn btn--copy" data-target="text-expose">📋 Kopieren</button>
              </div>
              <div class="panel__content" id="text-expose"></div>
            </div>

            <div class="results__panel" id="panel-immo">
              <div class="panel__top">
                <span class="panel__label">🏠 ImmoScout-Anzeige</span>
                <button class="btn btn--copy" data-target="text-immo">📋 Kopieren</button>
              </div>
              <div class="panel__content" id="text-immo"></div>
            </div>

            <div class="results__panel" id="panel-instagram">
              <div class="panel__top">
                <span class="panel__label">📸 Instagram Caption</span>
                <button class="btn btn--copy" data-target="text-instagram">📋 Kopieren</button>
              </div>
              <div class="panel__content" id="text-instagram"></div>
            </div>

            <div class="results__panel" id="panel-email">
              <div class="panel__top">
                <span class="panel__label">✉️ E-Mail an Interessenten</span>
                <button class="btn btn--copy" data-target="text-email">📋 Kopieren</button>
              </div>
              <div class="panel__content" id="text-email"></div>
            </div>

            <div class="results__panel" id="panel-whatsapp">
              <div class="panel__top">
                <span class="panel__label">💬 WhatsApp Nachricht</span>
                <button class="btn btn--copy" data-target="text-whatsapp">📋 Kopieren</button>
              </div>
              <div class="panel__content" id="text-whatsapp"></div>
            </div>

          </div>
        </div>
      </div>
